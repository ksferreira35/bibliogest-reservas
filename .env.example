# Copie para .env e selecione esse arquivo na configuração de execução do IntelliJ.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# PostgreSQL local de Reservas na porta 15433.
DB_URL=jdbc:postgresql://127.0.0.1:15433/bibliogest_reservas
DB_USERNAME=bibliogest_reservas
# Use aqui a mesma senha definida para o usuário do PostgreSQL local.
DB_PASSWORD=

OIDC_ISSUER_URI=https://login.ksferreira.org/realms/bibliogest
OIDC_JWK_SET_URI=https://login.ksferreira.org/realms/bibliogest/protocol/openid-connect/certs

ACERVO_BASE_URL=https://bibliogest.ksferreira.org/acervo
